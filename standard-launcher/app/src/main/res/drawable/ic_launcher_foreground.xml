<?xml version="1.0" encoding="utf-8"?>
<!-- Vanta mark: paper-outlined ink tile, display-weight V, one red accent square (the live-tile marker). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- tile outline, inset so square and squircle masks keep the whole frame -->
    <path
        android:strokeColor="#EDE9E0"
        android:strokeWidth="2.5"
        android:strokeLineJoin="miter"
        android:pathData="M28,28 L80,28 L80,80 L28,80 Z" />
    <!-- V -->
    <path
        android:fillColor="#EDE9E0"
        android:pathData="M35,38 L46,38 L52,59 L58,38 L69,38 L57,72 L47,72 Z" />
    <!-- accent square, top-right like a live tile -->
    <path
        android:fillColor="#D93A2B"
        android:pathData="M71,31 L78,31 L78,38 L71,38 Z" />
</vector>
